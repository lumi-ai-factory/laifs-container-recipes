ARG BASE_IMAGE
ARG BASE_IMAGE_TAG

FROM $BASE_IMAGE:$BASE_IMAGE_TAG

ARG TRANSFORMER_ENGINE_GPU_ARCH
ARG TRANSFORMER_ENGINE_COMMIT
ARG TRANSFORMER_ENGINE_REPO

ARG SRC_DIR="/opt/src"

ENV NVTE_FRAMEWORK=pytorch

RUN --mount=type=secret,id=github-netrc,target=/root/.netrc,mode=0600 \
  set -ue; \
  #
  export AOTRITON_TARGET_ARCH=${TRANSFORMER_ENGINE_GPU_ARCH}; \
  #
  export CMAKE_PREFIX_PATH=/opt/rocm; \
  #
  export GPU_ARCHS=${TRANSFORMER_ENGINE_GPU_ARCH}; \
  export GPU_TARGETS=${TRANSFORMER_ENGINE_GPU_ARCH}; \
  #
  export NVTE_ROCM_ARCH=${TRANSFORMER_ENGINE_GPU_ARCH}; \
  export NVTE_FUSED_ATTN=0; \
  export NVTE_USE_ROCM=1; \
  #
  git clone ${TRANSFORMER_ENGINE_REPO} ${SRC_DIR}/transformer_engine; \
  #
  cd ${SRC_DIR}/transformer_engine; \
  git checkout ${TRANSFORMER_ENGINE_COMMIT}; \
  git submodule update --init --recursive; \
  #
  # Version the wheel as <TE version>+lumi.aif.<GPU arch>.<commit>. Without
  # NVTE_NO_LOCAL_VERSION, TE would append its own +<commit> to the version.
  #
  export NVTE_NO_LOCAL_VERSION=1; \
  sed -i "1s/\$/+lumi.aif.${TRANSFORMER_ENGINE_GPU_ARCH}.${TRANSFORMER_ENGINE_COMMIT}/" build_tools/VERSION.txt; \
  #
  # --no-build-isolation needed for pytorch HIP support detection
  pip wheel --no-deps --no-build-isolation -v -w ${SRC_DIR}/transformer_engine/dist .; \
  wheel_path="$(find ${SRC_DIR}/transformer_engine/dist -mindepth 1 -maxdepth 1 -type f -name '*.whl')"; \
  test $(echo $wheel_path | wc -w) = 1; \
  #
  cd .. && pip install $wheel_path; \
  rm -rf ${SRC_DIR}/transformer_engine

RUN set -e; \
  #
  # Add SBOM, replacing the one inherited from the base image
  #
  apt_json="$(dpkg-query -W -f='${Package}\t${Version}\n' | jq -R -s 'split("\n")[:-1] | map(split("\t") | {name: .[0], version: .[1]})')"; \
  pip_json="$(pip list --format=json)"; \
  jq -n \
    --argjson apt "$apt_json" \
    --argjson pip "$pip_json" \
    '{apt: $apt, pip: $pip}' > /.sbom.json;

RUN printf '#!/usr/bin/env bash\n\
if [ "${SLURM_NNODES}" = 1 ] && [ -z "${SLURM_GPUS_ON_NODE}" ]; then\n\
    export FI_HMEM_DISABLE_P2P=1\n\
fi\n\
if [ "${ROCR_USE_SLURM_LOCALID}" = 1 ] && [ -n "${SLURM_LOCALID}" ]; then\n\
    export ROCR_VISIBLE_DEVICES="$SLURM_LOCALID"\n\
fi\n\
if [ "${MAP_HIP_TO_ROCR_VISIBLE_DEVICES}" = 1 ] && [ -n "${ROCR_VISIBLE_DEVICES}" ]; then\n\
    export HIP_VISIBLE_DEVICES=`seq -s , 0 $(echo "${ROCR_VISIBLE_DEVICES%%,}" | awk -F, '\''{print NF-1}'\'')`\n\
fi\n\
exec "$@"\n' > /opt/oci-entrypoint.sh && chmod +x /opt/oci-entrypoint.sh

ENTRYPOINT ["/opt/oci-entrypoint.sh"]
