ARG BASE_IMAGE
ARG BASE_IMAGE_TAG

FROM $BASE_IMAGE:$BASE_IMAGE_TAG

ARG FULL_APT_PACKAGES

ARG BUILD_PIP_PACKAGES
ARG FULL_PIP_PACKAGES
# ARG WRETAG_REPO
# ARG WRETAG_COMMIT

ARG FULL_GPU_ARCH

ARG SRC_DIR="/opt/src"
ARG MAX_JOBS

# Silence Clang warnings that xformers turns into errors with -Werror:
# - deprecated-attributes: HIP attributes on deduction guides in Composable
#   Kernel headers (flash-attention, xformers)
# - c++20-extensions: C++20 bit-field initializers in PyTorch 2.13 headers,
#   which xformers compiles with -std=c++17
# As an ARG, it applies to the build steps below but is not kept in the image.
ARG HIPCC_COMPILE_FLAGS_APPEND="-Wno-deprecated-attributes -Wno-c++20-extensions"

# The extension builds below cache compiler output in the full-ccache cache
# mount, which persists between builds. PyTorch's extension builder runs the
# HIP compiler given in PYTORCH_NVCC, and vLLM uses ccache whenever installed.

#
# Prepare build environment
#
RUN set -ue; \
  #
  mkdir ${SRC_DIR}; \
  #
  # revisit:
  #
  #   Even with the various GPU arch options set, we still get these type of complaints from
  #   various HIP build steps: "GPU_TARGETS was not set, and system GPU detection was unsuccsesful"
  #   This is reverted at the last RUN step at the bottom of this file. Lets get rid ot this later.
  #
  #   Another thing is that we may prefer to change this to use separate builder container and then
  #   do fresh install of all the packages similar to the libfabric and mpich builds.
  #
  test -f /opt/rocm/lib/llvm/bin/amdgpu-arch.really && { echo "error: amdgpu-arch.really already exists"; false; } || true; \
  mv /opt/rocm/lib/llvm/bin/amdgpu-arch /opt/rocm/lib/llvm/bin/amdgpu-arch.really; \
  printf "#!/bin/bash\necho ${FULL_GPU_ARCH}\n" > /opt/rocm/lib/llvm/bin/amdgpu-arch; \
  chmod a+rx /opt/rocm/lib/llvm/bin/amdgpu-arch; \
  #
  # Recreate the ROCm version file that the ROCm multi-arch packages don't
  # ship. apex and DeepSpeed read the ROCm version from it, and otherwise try
  # to parse it from the PyTorch version string, which fails.
  #
  mkdir -p /opt/rocm/.info; \
  awk '/^#define ROCM_VERSION_(MAJOR|MINOR|PATCH) /{v=v (v?".":"") $3} END{print v}' \
    /opt/rocm/include/rocm-core/rocm_version.h > /opt/rocm/.info/version; \
  test -s /opt/rocm/.info/version; \
  #
  apt-get update && \
  apt-get -y --no-install-recommends install ${FULL_APT_PACKAGES} && \
  rm -rf /var/lib/apt/lists/*; \
  #
  # pip install --no-cache-dir "git+${WRETAG_REPO}@${WRETAG_COMMIT}"; \
  pip install --upgrade-strategy=only-if-needed --no-cache-dir ${BUILD_PIP_PACKAGES} ${FULL_PIP_PACKAGES};

#
# Compile and install Flash Attention
#
ARG FLASH_ATTENTION_COMMIT
ARG FLASH_ATTENTION_REPO

RUN --mount=type=secret,id=github-netrc,target=/root/.netrc,mode=0600 \
    --mount=type=cache,id=full-ccache,target=/root/.cache/ccache \
  #
  set -ue; \
  export MAX_JOBS="${MAX_JOBS:-$(nproc)}"; \
  #
  export CCACHE_DIR=/root/.cache/ccache CCACHE_MAXSIZE=20G; \
  export PYTORCH_NVCC="ccache /opt/rocm/bin/hipcc"; \
  #
  git clone $FLASH_ATTENTION_REPO ${SRC_DIR}/flash-attention; \
  cd ${SRC_DIR}/flash-attention; \
  git checkout $FLASH_ATTENTION_COMMIT; \
  #
  export FLASH_ATTN_LOCAL_VERSION="lumi.aif.${FULL_GPU_ARCH}.${FLASH_ATTENTION_COMMIT}"; \
  export FLASH_ATTENTION_FORCE_BUILD=1; \
  #
  BUILD_TARGET=rocm GPU_ARCHS=$FULL_GPU_ARCH \
    python -m pip wheel --no-build-isolation --no-deps -v -w dist/ .; \
  wheel_path="$(find ${SRC_DIR}/flash-attention/dist  -mindepth 1 -maxdepth 1 -type f -name '*.whl')"; \
  test $(echo $wheel_path | wc -w) = 1; \
  #
  cd .. && pip install --no-cache-dir $wheel_path; \
  rm -rf ${SRC_DIR}/flash-attention;

#
# Install causal-conv1d
#
ARG CAUSAL_CONV1D_COMMIT
ARG CAUSAL_CONV1D_REPO

RUN --mount=type=secret,id=github-netrc,target=/root/.netrc,mode=0600 \
    --mount=type=cache,id=full-ccache,target=/root/.cache/ccache \
  #
  set -ue; \
  export MAX_JOBS="${MAX_JOBS:-$(nproc)}"; \
  #
  export CCACHE_DIR=/root/.cache/ccache CCACHE_MAXSIZE=20G; \
  export PYTORCH_NVCC="ccache /opt/rocm/bin/hipcc"; \
  #
  git clone $CAUSAL_CONV1D_REPO ${SRC_DIR}/causal-conv1d; \
  cd ${SRC_DIR}/causal-conv1d; \
  git checkout $CAUSAL_CONV1D_COMMIT; \
  #
  export PYTORCH_ROCM_ARCH_OVERRIDE="${FULL_GPU_ARCH}"; \
  export HIP_ARCHITECTURES="${FULL_GPU_ARCH}"; \
  export CAUSAL_CONV1D_LOCAL_VERSION="lumi.aif.${FULL_GPU_ARCH}.${CAUSAL_CONV1D_COMMIT}"; \
  export CAUSAL_CONV1D_FORCE_BUILD=1; \
  #
  pip wheel --no-deps --no-build-isolation -v -w ${SRC_DIR}/causal-conv1d/dist .; \
  wheel_path="$(find ${SRC_DIR}/causal-conv1d/dist  -mindepth 1 -maxdepth 1 -type f -name '*.whl')"; \
  test $(echo $wheel_path | wc -w) = 1; \
  #
  cd .. && pip install --no-cache-dir $wheel_path; \
  rm -rf ${SRC_DIR}/causal-conv1d;

#
# Install xFormers
#
ARG XFORMERS_COMMIT
ARG XFORMERS_REPO

RUN --mount=type=secret,id=github-netrc,target=/root/.netrc,mode=0600 \
    --mount=type=cache,id=full-ccache,target=/root/.cache/ccache \
  #
  set -ue; \
  export MAX_JOBS="${MAX_JOBS:-$(nproc)}"; \
  #
  export CCACHE_DIR=/root/.cache/ccache CCACHE_MAXSIZE=20G; \
  export PYTORCH_NVCC="ccache /opt/rocm/bin/hipcc"; \
  #
  git clone $XFORMERS_REPO ${SRC_DIR}/xformers && \
  cd ${SRC_DIR}/xformers && \
  git checkout $XFORMERS_COMMIT && \
  git submodule update --init --recursive; \
  #
  export XFORMERS_CK_FLASH_ATTN=1; \
  export HIP_ARCHITECTURES="${FULL_GPU_ARCH}"; \
  #
  # BUILD_VERSION replaces the version xformers would otherwise build from
  # version.txt and a +<commit>.d<date> suffix.
  export BUILD_VERSION="$(cat version.txt)+lumi.aif.${FULL_GPU_ARCH}.${XFORMERS_COMMIT}"; \
  #
  pip wheel --no-deps --no-build-isolation -v -w ${SRC_DIR}/xformers/dist .; \
  wheel_path="$(find ${SRC_DIR}/xformers/dist -mindepth 1 -maxdepth 1 -type f -name '*.whl')"; \
  test $(echo $wheel_path | wc -w) = 1; \
  #
  cd .. && pip install --no-cache-dir $wheel_path; \
  rm -rf ${SRC_DIR}/xformers; \
  #
  python -m xformers.info

#
# Install Apex
#
ARG APEX_COMMIT
ARG APEX_REPO

RUN --mount=type=secret,id=github-netrc,target=/root/.netrc,mode=0600 \
    --mount=type=cache,id=full-ccache,target=/root/.cache/ccache \
  #
  set -ue; \
  export MAX_JOBS="${MAX_JOBS:-$(nproc)}"; \
  #
  export CCACHE_DIR=/root/.cache/ccache CCACHE_MAXSIZE=20G; \
  export PYTORCH_NVCC="ccache /opt/rocm/bin/hipcc"; \
  #
  git clone "${APEX_REPO}" ${SRC_DIR}/apex;\
  cd ${SRC_DIR}/apex; \
  git checkout "${APEX_COMMIT}"; \
  #
  export PYTORCH_ROCM_ARCH="${FULL_GPU_ARCH}"; \
  #
  # Version the wheel as <apex version>+lumi.aif.<GPU arch>.<commit>.
  # BUILD_VERSION replaces the version apex would read from version.txt.
  export BUILD_VERSION="$(cat version.txt)+lumi.aif.${FULL_GPU_ARCH}.${APEX_COMMIT}"; \
  #
  APEX_BUILD_CPP_OPS=1 APEX_BUILD_CUDA_OPS=1 \
    pip wheel --no-deps --no-build-isolation -v -w ${SRC_DIR}/apex/dist .; \
  wheel_path="$(find ${SRC_DIR}/apex/dist  -mindepth 1 -maxdepth 1 -type f -name '*.whl')"; \
  test $(echo $wheel_path | wc -w) = 1; \
  #
  cd .. && pip install --no-cache-dir $wheel_path; \
  rm -rf ${SRC_DIR}/apex;

#
# Compile and install vLLM
#
ARG VLLM_COMMIT
ARG VLLM_REPO
ARG VLLM_VERSION

RUN --mount=type=secret,id=github-netrc,target=/root/.netrc,mode=0600 \
    --mount=type=cache,id=full-ccache,target=/root/.cache/ccache \
  #
  set -ue; \
  export MAX_JOBS="${MAX_JOBS:-$(nproc)}"; \
  #
  export CCACHE_DIR=/root/.cache/ccache CCACHE_MAXSIZE=20G; \
  export PYTORCH_NVCC="ccache /opt/rocm/bin/hipcc"; \
  #
  git clone ${VLLM_REPO} ${SRC_DIR}/vllm; \
  cd ${SRC_DIR}/vllm; \
  git fetch --tags; \
  git checkout $VLLM_COMMIT; \
  #
  export MAKEFLAGS="-j${MAX_JOBS}"; \
  # revisit: which of the arch defs really makes a difference
  # export AMDGPU_TARGETS=$FULL_GPU_ARCH; \
  # export GPU_ARCHS=$FULL_GPU_ARCH; \
  # export GPU_TARGETS=$FULL_GPU_ARCH; \
  # export HIP_ARCHITECTURES=$FULL_GPU_ARCH; \
  export VLLM_TARGET_DEVICE=rocm; \
  export PYTORCH_ROCM_ARCH=$FULL_GPU_ARCH; \
  export VLLM_VERSION_OVERRIDE=${VLLM_VERSION}+lumi.aif.${FULL_GPU_ARCH}.${VLLM_COMMIT}; \
  #
  python setup.py bdist_wheel -v --dist-dir=dist; \
  wheel_path="$(find ${SRC_DIR}/vllm/dist  -mindepth 1 -maxdepth 1 -type f -name '*.whl')"; \
  test $(echo $wheel_path | wc -w) = 1; \
  #
  cd .. && pip install $wheel_path; \
  # Install vLLM audio libraries
  pip install vllm[audio]==${VLLM_VERSION}; \
  rm -rf ${SRC_DIR}/vllm;

