#
# Final image: the Python packages and the built wheels on top of base
#
FROM base

ARG VLLM_VERSION

# Install the built wheels first, in the same order as they used to be
# built, so that their dependencies, vLLM's pinned ones in particular, decide
# the versions of shared packages.
RUN --mount=type=bind,from=flash-attention,source=/wheels,target=/wheels/flash-attention \
    --mount=type=bind,from=causal-conv1d,source=/wheels,target=/wheels/causal-conv1d \
    --mount=type=bind,from=xformers,source=/wheels,target=/wheels/xformers \
    --mount=type=bind,from=apex,source=/wheels,target=/wheels/apex \
    --mount=type=bind,from=vllm,source=/wheels,target=/wheels/vllm \
    --mount=type=bind,from=deepspeed,source=/wheels,target=/wheels/deepspeed \
    --mount=type=bind,from=megatron-lm,source=/wheels,target=/wheels/megatron-lm \
  #
  set -eu; \
  #
  # With PyTorch's ROCm wheels, Triton is the triton-rocm package. It has the
  # same triton module as the CUDA triton package, but another name, so a
  # requirement for triton, e.g. from vLLM's xgrammar, would install the CUDA
  # triton from PyPI over it. Install a stub package named triton with the
  # same version, which only requires triton-rocm, so that such requirements
  # are already met. The stub contains no files of the triton module.
  rocm_triton="$(pip show triton-rocm 2>/dev/null | awk '/^Version:/{print $2}')"; \
  if [ -n "$rocm_triton" ] && ! pip show triton >/dev/null 2>&1; then \
    mkdir /tmp/triton-stub; \
    printf '[build-system]\nrequires = ["setuptools"]\nbuild-backend = "setuptools.build_meta"\n\n[project]\nname = "triton"\nversion = "%s"\ndescription = "Stub that makes requirements for triton use triton-rocm"\ndependencies = ["triton-rocm==%s"]\n\n[tool.setuptools]\npackages = []\n' \
      "$rocm_triton" "$rocm_triton" > /tmp/triton-stub/pyproject.toml; \
    pip install /tmp/triton-stub; \
    rm -rf /tmp/triton-stub; \
  fi; \
  #
  # Keep the installed PyTorch packages: constrain them to their exact
  # versions, so that a package needing other versions stops the install
  # instead of replacing them, e.g. with CUDA builds from PyPI
  pip list --format=freeze | grep -E -i '^(torch|torchvision|torchaudio|triton([-_]rocm)?)==' > /tmp/constraints.txt; \
  export PIP_CONSTRAINT=/tmp/constraints.txt; \
  #
  pip install /wheels/flash-attention/*.whl; \
  pip install /wheels/causal-conv1d/*.whl; \
  pip install /wheels/xformers/*.whl; \
  pip install /wheels/apex/*.whl; \
  #
  pip install /wheels/vllm/*.whl; \
  # Install vLLM audio libraries
  pip install vllm[audio]==${VLLM_VERSION}; \
  #
  pip install /wheels/deepspeed/*.whl; \
  #
  pip install /wheels/megatron-lm/*.whl; \
  # Fix python -c "from megatron.core.datasets.utils import compile_helpers; compile_helpers()"
  DIR=/opt/venv/lib/python3.12/site-packages/megatron/core/datasets; \
  printf 'all:\n\t@ls helpers_cpp*.so >/dev/null 2>&1 || { echo "helpers_cpp .so missing" >&2; exit 1; }\n' > "$DIR/Makefile";

ARG BUILD_PIP_PACKAGES
ARG FULL_PIP_PACKAGES

# Install the extra Python packages last. Changing their list then only
# reruns this step.
RUN set -eu; \
  #
  # Keep the PyTorch packages and our own builds (versions with +lumi.aif)
  # at their installed versions, as constraints and as requirements. As
  # requirements, pip also resolves their dependencies, so the extra packages
  # can't break e.g. vLLM's exact pins, while the other installed packages may
  # still change for them.
  pins="$(pip list --format=freeze | grep -E -i '^(torch|torchvision|torchaudio|triton([-_]rocm)?)==|\+lumi\.aif')"; \
  echo "$pins" > /tmp/constraints.txt; \
  cat /tmp/constraints.txt; \
  export PIP_CONSTRAINT=/tmp/constraints.txt; \
  #
  pip install $pins ${BUILD_PIP_PACKAGES} ${FULL_PIP_PACKAGES}; \
  #
  # Check that our PyTorch is still the one installed.
  python -c "import torch; assert torch.version.hip and 'lumi.aif' in torch.__version__, torch.__version__"; \
  #
  # Check that the triton module is still the ROCm one
  if [ -n "$(pip show triton-rocm 2>/dev/null)" ]; then \
    python -c "import triton; from importlib.metadata import version; assert triton.__version__ == version('triton-rocm'), (triton.__version__, version('triton-rocm'))"; \
  fi; \
  #
  # Check that the compiled extensions load, e.g. that they find their
  # libraries and match our PyTorch build. This works without a GPU.
  python -c "import torch, flash_attn_2_cuda, causal_conv1d_cuda, apex.amp_C, apex.fused_layer_norm_cuda, vllm._C_stable_libtorch, vllm.third_party.triton_kernels.target_info; from megatron.core.datasets import helpers_cpp"; \
  #
  # Reports for the build log. GPU checks show no GPU, as the build host has none.
  python -m torch.utils.collect_env; \
  python -m xformers.info; \
  # Without a GPU, DeepSpeed would pick its CPU accelerator and report
  # the built CUDA ops as not installed
  DS_ACCELERATOR=cuda ds_report; \
  python -m vllm.collect_env; \
  # Unmet requirements, for information only, as some known conflicts are accepted
  pip check || true

RUN set -ue; \
  #
  # Add SBOM
  apt_json="$(dpkg-query -W -f='${Package}\t${Version}\n' | jq -R -s 'split("\n")[:-1] | map(split("\t") | {name: .[0], version: .[1]})')"; \
  pip_json="$(pip list --format=json)"; \
  jq -n --argjson apt "$apt_json" \
        --argjson pip "$pip_json" \
        '{apt: $apt, pip: $pip}' \
        > /.sbom.json;

RUN printf '#!/usr/bin/env bash\n\
if [ "${SLURM_NNODES}" = 1 ] && [ -z "${SLURM_GPUS_ON_NODE}" ]; then\n\
    export FI_HMEM_DISABLE_P2P=1\n\
fi\n\
if [ "${ROCR_USE_SLURM_LOCALID}" = 1 ] && [ -n "${SLURM_LOCALID}" ]; then\n\
    export ROCR_VISIBLE_DEVICES="$SLURM_LOCALID"\n\
fi\n\
if [ "${MAP_HIP_TO_ROCR_VISIBLE_DEVICES}" = 1 ] && [ -n "${ROCR_VISIBLE_DEVICES}" ]; then\n\
    export HIP_VISIBLE_DEVICES=`seq -s , 0 $(echo "${ROCR_VISIBLE_DEVICES%%,}" | awk -F, '\''{print NF-1}'\'')`\n\
fi\n\
exec "$@"\n' > /opt/oci-entrypoint.sh && chmod +x /opt/oci-entrypoint.sh

# Don't send usage statistics to third parties: vLLM to stats.vllm.ai and
# Hugging Face Hub to huggingface.co. DO_NOT_TRACK is the common opt-out
# that some other tools follow as well. Users can unset these to opt in.
ENV VLLM_NO_USAGE_STATS=1
ENV HF_HUB_DISABLE_TELEMETRY=1
ENV DO_NOT_TRACK=1

ENTRYPOINT ["/opt/oci-entrypoint.sh"]
