ARG BASE_IMAGE
ARG BASE_IMAGE_TAG

# Stages:
# - base: Ubuntu packages and the ROCm version file, shared by all stages
# - builder: build tools and settings for compiling the packages
# - each individual stage builds the wheel of one package into /wheels
# - the final stage installs the Python packages and the built wheels on base
#
# Each package stage only declares the ARGs of its own package, so changing
# e.g. the vLLM commit only rebuilds the vllm stage and the final install.
# The build stages and their settings are not part of the final image.

#
# Base for the builder stages and the final image
#
FROM $BASE_IMAGE:$BASE_IMAGE_TAG AS base

ARG FULL_APT_PACKAGES

RUN set -ue; \
  #
  # Recreate the ROCm version file if it's missing: the ROCm multi-arch
  # packages (7.14) don't ship it, unlike rocm-core in ROCm 7.2. apex and
  # DeepSpeed read the ROCm version from it, and otherwise try to parse it
  # from the PyTorch version string, which fails.
  #
  if [ ! -s /opt/rocm/.info/version ]; then \
    mkdir -p /opt/rocm/.info; \
    awk '/^#define ROCM_VERSION_(MAJOR|MINOR|PATCH) /{v=v (v?".":"") $3} END{print v}' \
      /opt/rocm/include/rocm-core/rocm_version.h > /opt/rocm/.info/version; \
  fi; \
  test -s /opt/rocm/.info/version; \
  #
  apt-get update && \
  apt-get -y --no-install-recommends install ${FULL_APT_PACKAGES} && \
  rm -rf /var/lib/apt/lists/*

#
# Build environment shared by the package stages
#
FROM base AS builder

ARG BUILD_PIP_PACKAGES
ARG FULL_GPU_ARCH
ARG FULL_MAX_JOBS

# Settings for the package builds. As ENV of a build stage, they apply to
# the stages built on this one but are not part of the final image.
#
# Target GPU architecture, and the number of parallel compile jobs. An empty
# MAX_JOBS means one per CPU core, see the package builds.
ENV GPU_ARCH=${FULL_GPU_ARCH}
ENV MAX_JOBS=${FULL_MAX_JOBS}
#
# Cache compiler output in the full-ccache cache mount, which persists
# between builds. PyTorch's extension builder runs the HIP compiler given in
# PYTORCH_NVCC, and vLLM uses ccache whenever installed.
#
# The HIP compiler flags are given in PYTORCH_NVCC, so that they are on
# the compile command lines. ccache doesn't see flags given in the
# environment (HIPCC_COMPILE_FLAGS_APPEND), so it would reuse output, warnings
# included, from compiles without them. The flags silence Clang warnings that
# xformers turns into errors with -Werror:
# - deprecated-attributes: HIP attributes on deduction guides in Composable
#   Kernel headers (flash-attention, xformers)
# - c++20-extensions: C++20 bit-field initializers in PyTorch 2.13 headers,
#   which xformers compiles with -std=c++17
ENV CCACHE_DIR=/root/.cache/ccache
ENV CCACHE_MAXSIZE=20G
ENV PYTORCH_NVCC="ccache /opt/rocm/bin/hipcc -Wno-deprecated-attributes -Wno-c++20-extensions"
#
ENV SRC_DIR=/opt/src

RUN set -ue; \
  #
  mkdir ${SRC_DIR} /wheels; \
  #
  # Some HIP builds detect the GPU with amdgpu-arch and complain that "system
  # GPU detection was unsuccessful" when the build host has no GPU, even with
  # the GPU architecture options set. Make amdgpu-arch report the target GPU
  # architecture. This is only in the builder stages, not in the final image.
  #
  mv /opt/rocm/lib/llvm/bin/amdgpu-arch /opt/rocm/lib/llvm/bin/amdgpu-arch.really; \
  printf "#!/bin/bash\necho ${GPU_ARCH}\n" > /opt/rocm/lib/llvm/bin/amdgpu-arch; \
  chmod a+rx /opt/rocm/lib/llvm/bin/amdgpu-arch; \
  #
  pip install --upgrade-strategy=only-if-needed ${BUILD_PIP_PACKAGES}

#
# Build Flash Attention
#
FROM builder AS flash-attention

ARG FLASH_ATTENTION_COMMIT
ARG FLASH_ATTENTION_REPO

RUN --mount=type=secret,id=github-netrc,target=/root/.netrc,mode=0600 \
    --mount=type=cache,id=full-ccache,target=/root/.cache/ccache \
  #
  set -ue; \
  export MAX_JOBS="${MAX_JOBS:-$(nproc)}"; \
  #
  git clone $FLASH_ATTENTION_REPO ${SRC_DIR}/flash-attention; \
  cd ${SRC_DIR}/flash-attention; \
  git checkout $FLASH_ATTENTION_COMMIT; \
  #
  export FLASH_ATTN_LOCAL_VERSION="lumi.aif.${GPU_ARCH}.${FLASH_ATTENTION_COMMIT}"; \
  # Build from source, without looking for a prebuilt wheel ("TRUE" is the only
  # value flash-attention accepts)
  export FLASH_ATTENTION_FORCE_BUILD=TRUE; \
  #
  BUILD_TARGET=rocm GPU_ARCHS=$GPU_ARCH \
    python -m pip wheel --no-build-isolation --no-deps -v -w /wheels .; \
  test $(find /wheels -name '*.whl' | wc -l) = 1; \
  #
  cd .. && rm -rf ${SRC_DIR}/flash-attention

#
# Build causal-conv1d
#
FROM builder AS causal-conv1d

ARG CAUSAL_CONV1D_COMMIT
ARG CAUSAL_CONV1D_REPO

RUN --mount=type=secret,id=github-netrc,target=/root/.netrc,mode=0600 \
    --mount=type=cache,id=full-ccache,target=/root/.cache/ccache \
  #
  set -ue; \
  export MAX_JOBS="${MAX_JOBS:-$(nproc)}"; \
  #
  git clone $CAUSAL_CONV1D_REPO ${SRC_DIR}/causal-conv1d; \
  cd ${SRC_DIR}/causal-conv1d; \
  git checkout $CAUSAL_CONV1D_COMMIT; \
  #
  export PYTORCH_ROCM_ARCH_OVERRIDE="${GPU_ARCH}"; \
  export HIP_ARCHITECTURES="${GPU_ARCH}"; \
  export CAUSAL_CONV1D_LOCAL_VERSION="lumi.aif.${GPU_ARCH}.${CAUSAL_CONV1D_COMMIT}"; \
  # Build from source, without looking for a prebuilt wheel ("TRUE" is the only
  # value causal-conv1d accepts)
  export CAUSAL_CONV1D_FORCE_BUILD=TRUE; \
  #
  pip wheel --no-deps --no-build-isolation -v -w /wheels .; \
  test $(find /wheels -name '*.whl' | wc -l) = 1; \
  #
  cd .. && rm -rf ${SRC_DIR}/causal-conv1d

#
# Build xFormers
#
FROM builder AS xformers

ARG XFORMERS_COMMIT
ARG XFORMERS_REPO

RUN --mount=type=secret,id=github-netrc,target=/root/.netrc,mode=0600 \
    --mount=type=cache,id=full-ccache,target=/root/.cache/ccache \
  #
  set -ue; \
  export MAX_JOBS="${MAX_JOBS:-$(nproc)}"; \
  #
  git clone $XFORMERS_REPO ${SRC_DIR}/xformers; \
  cd ${SRC_DIR}/xformers; \
  git checkout $XFORMERS_COMMIT; \
  git submodule update --init --recursive; \
  #
  export XFORMERS_CK_FLASH_ATTN=1; \
  export HIP_ARCHITECTURES="${GPU_ARCH}"; \
  #
  # BUILD_VERSION replaces the version xformers would otherwise build from
  # version.txt and a +<commit>.d<date> suffix.
  export BUILD_VERSION="$(cat version.txt)+lumi.aif.${GPU_ARCH}.${XFORMERS_COMMIT}"; \
  #
  pip wheel --no-deps --no-build-isolation -v -w /wheels .; \
  test $(find /wheels -name '*.whl' | wc -l) = 1; \
  #
  cd .. && rm -rf ${SRC_DIR}/xformers

#
# Build Apex
#
FROM builder AS apex

ARG APEX_COMMIT
ARG APEX_REPO

RUN --mount=type=secret,id=github-netrc,target=/root/.netrc,mode=0600 \
    --mount=type=cache,id=full-ccache,target=/root/.cache/ccache \
  #
  set -ue; \
  export MAX_JOBS="${MAX_JOBS:-$(nproc)}"; \
  #
  git clone "${APEX_REPO}" ${SRC_DIR}/apex; \
  cd ${SRC_DIR}/apex; \
  git checkout "${APEX_COMMIT}"; \
  #
  export PYTORCH_ROCM_ARCH="${GPU_ARCH}"; \
  #
  # Silence the most frequent harmless warnings: ignored hipError_t return
  # values and loops the compiler can't unroll in apex's HIP code (hipcc), and
  # the C++20 bit-field initializers in PyTorch 2.13 headers and deprecated
  # PyTorch APIs used by apex.
  export PYTORCH_NVCC="${PYTORCH_NVCC} -Wno-unused-value -Wno-pass-failed"; \
  export CFLAGS="-Wno-c++20-extensions -Wno-deprecated-declarations"; \
  #
  # Version the wheel as <apex version>+lumi.aif.<GPU arch>.<commit>.
  # BUILD_VERSION replaces the version apex would read from version.txt.
  export BUILD_VERSION="$(cat version.txt)+lumi.aif.${GPU_ARCH}.${APEX_COMMIT}"; \
  #
  APEX_BUILD_CPP_OPS=1 APEX_BUILD_CUDA_OPS=1 \
    pip wheel --no-deps --no-build-isolation -v -w /wheels .; \
  test $(find /wheels -name '*.whl' | wc -l) = 1; \
  #
  cd .. && rm -rf ${SRC_DIR}/apex

#
# Build vLLM
#
FROM builder AS vllm

ARG VLLM_COMMIT
ARG VLLM_REPO
ARG VLLM_VERSION

RUN --mount=type=secret,id=github-netrc,target=/root/.netrc,mode=0600 \
    --mount=type=cache,id=full-ccache,target=/root/.cache/ccache \
  #
  set -ue; \
  export MAX_JOBS="${MAX_JOBS:-$(nproc)}"; \
  #
  git clone ${VLLM_REPO} ${SRC_DIR}/vllm; \
  cd ${SRC_DIR}/vllm; \
  git fetch --tags; \
  git checkout $VLLM_COMMIT; \
  #
  export MAKEFLAGS="-j${MAX_JOBS}"; \
  # revisit: which of the arch defs really makes a difference
  # export AMDGPU_TARGETS=$GPU_ARCH; \
  # export GPU_ARCHS=$GPU_ARCH; \
  # export GPU_TARGETS=$GPU_ARCH; \
  # export HIP_ARCHITECTURES=$GPU_ARCH; \
  export VLLM_TARGET_DEVICE=rocm; \
  export PYTORCH_ROCM_ARCH=$GPU_ARCH; \
  export VLLM_VERSION_OVERRIDE=${VLLM_VERSION}+lumi.aif.${GPU_ARCH}.${VLLM_COMMIT}; \
  #
  # vLLM bundles triton_kernels (vllm/third_party/triton_kernels) from the
  # ROCm Triton commit pinned in cmake/external_projects/triton_kernels.cmake.
  # From v0.31.0 on, that is from the Triton 3.8 branch, which imports names
  # that Triton 3.7.1 doesn't have, e.g. is_hip_gfx1250, and vLLM's MXFP4 MoE
  # code (gpt-oss) needs its API. The final stage imports it as a check.
  python setup.py bdist_wheel -v --dist-dir=/wheels; \
  test $(find /wheels -name '*.whl' | wc -l) = 1; \
  #
  cd .. && rm -rf ${SRC_DIR}/vllm

#
# Build DeepSpeed
#
FROM builder AS deepspeed

ARG DEEPSPEED_VERSION

RUN --mount=type=cache,id=full-ccache,target=/root/.cache/ccache \
  #
  set -ue; \
  export MAX_JOBS="${MAX_JOBS:-$(nproc)}"; \
  #
  src=${SRC_DIR}/deepspeed; \
  mkdir -p $src; \
  python -m pip download \
    "deepspeed==${DEEPSPEED_VERSION}" \
    --no-deps \
    --no-binary=:all: \
    -d "$src"; \
  # Build in a fixed directory: pip would unpack the sdist into a random
  # temporary directory, whose path ccache can't match between builds
  tar -xzf "$src/deepspeed-${DEEPSPEED_VERSION}.tar.gz" -C "$src"; \
  #
  export PYTORCH_ROCM_ARCH=$GPU_ARCH; \
  export DS_ACCELERATOR=cuda; \
  export DS_BUILD_OPS=1; \
  #
  # Some extensions need to be disabled
  #
  # https://github.com/deepspeedai/DeepSpeed/issues/7843#issuecomment-3896637925
  #
  export DS_BUILD_INFERENCE_CORE_OPS=0; \
  export DS_BUILD_CUTLASS_OPS=0; \
  export DS_BUILD_RAGGED_DEVICE_OPS=0; \
  export DS_BUILD_RAGGED_OPS=0; \
  # Since 0.19.8, FP Quantizer is built with any Triton version, and its
  # kernels don't compile with hipcc (declaration shadows template parameter)
  export DS_BUILD_FP_QUANTIZER=0; \
  export DS_BUILD_STRING="+lumi.aif.${GPU_ARCH}.dsops"; \
  #
  python -m pip wheel \
    "$src/deepspeed-${DEEPSPEED_VERSION}" \
    --no-deps \
    --no-build-isolation \
    -v \
    -w /wheels; \
  test $(find /wheels -name '*.whl' | wc -l) = 1; \
  #
  rm -rf $src

#
# Build Megatron LM (experimental for testing)
#
FROM builder AS megatron-lm

ARG MEGATRON_LM_REPO
ARG MEGATRON_LM_COMMIT

RUN --mount=type=secret,id=github-netrc,target=/root/.netrc,mode=0600 \
  #
  set -ue; \
  export MAX_JOBS="${MAX_JOBS:-$(nproc)}"; \
  #
  git clone ${MEGATRON_LM_REPO} ${SRC_DIR}/megatronlm; \
  cd ${SRC_DIR}/megatronlm; \
  git checkout ${MEGATRON_LM_COMMIT}; \
  #
  # Version the wheel as <Megatron version>+lumi.aif.<commit>. NO_VCS_VERSION
  # stops Megatron from appending +<git hash> during the build.
  export NO_VCS_VERSION=1; \
  sed -i "/^__version__ = /a __version__ += '+lumi.aif.${MEGATRON_LM_COMMIT}'" megatron/core/package_info.py; \
  #
  pip wheel --no-deps -w /wheels .; \
  test $(find /wheels -name '*.whl' | wc -l) = 1; \
  #
  cd .. && rm -rf ${SRC_DIR}/megatronlm

