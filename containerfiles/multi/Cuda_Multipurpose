RUN set -ue; \
        . /opt/venv/bin/activate; \
        mkdir -p /opt/src; \
        ###################
        # Flash Attention #
        ###################
        # prepare environment - subset of variables found in setup.py
        # build from source - we have to because of aarch64
        export FLASH_ATTENTION_FORCE_BUILD="TRUE"; \
        # ensure the build is for Hopper
        export FLASH_ATTENTION_DISABLE_SM80="TRUE"; \
        # leave BF16, FP8 - yes, we sacrifice precision for gaining dynamic range
        export FLASH_ATTENTION_DISABLE_FP16="TRUE"; \
        git clone $FLASH_ATTENTION_REPO_URL /opt/src/flash-attention; \
        cd /opt/src/flash-attention; \
        git checkout $FLASH_ATTENTION_REPO_COMMIT; \
        #BUILD_TARGET=rocm MAX_JOBS=$(nproc) GPU_ARCHS=$FLASH_ATTENTION_GPU_ARCHS python3 setup.py bdist_wheel --dist-dir=dist; \
        cd hopper; \
        BUILD_TARGET=cuda MAX_JOBS=$(nproc) python3 setup.py bdist_wheel --dist-dir=dist; \
        wheel_path="$(find /opt/src/flash-attention/hopper/dist  -mindepth 1 -maxdepth 1 -type f -name '*.whl')"; \
        test $(echo $wheel_path | wc -w) = 1; \
        pip install --no-cache-dir $wheel_path; \
        cd / && rm -rf /opt/src/flash-attention;
#       new_wheel="$(wretag -d -q lumi_aif_${MULTI_IMAGE_GPU_ARCH}_${FLASH_ATTENTION_REPO_COMMIT} $wheel_path)"; \
