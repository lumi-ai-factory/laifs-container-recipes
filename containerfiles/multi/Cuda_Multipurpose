  test $(echo $wheel_path | wc -w) = 1; \
  pip install $wheel_path; \
  cd / && rm -rf /opt/src/megatronlm;

#
# Cleanup and finalize
#
RUN set -ue; \
  #
  rmdir /opt/src;

CMD ["/bin/bash"]
