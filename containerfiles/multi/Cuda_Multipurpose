#
# Install xFormers
#
# TODO: double-check XFORMERS_OK_FLASH_ATTN - is it ok to include
## GH200 is sm_90 so adding:
# export TORCH_CUDA_ARCH_LIST="9.0+PTX"
# from github - might be useful:
#Missing Features: If memory-efficient attention is missing, it indicates a compiler mismatch or incorrect TORCH_CUDA_ARCH_LIST.
#For specialized GH200 setups using unified memory, you may need to patch PyTorch to ensure stability

RUN set -ue; \
  . /opt/venv/bin/activate; \
  git clone $XFORMERS_REPO /opt/src/xformers; \
  cd /opt/src/xformers; \
  git checkout $XFORMERS_COMMIT; \
  git submodule update --init --recursive; \
  export XFORMERS_CK_FLASH_ATTN=1; \
  export TORCH_CUDA_ARCH_LIST="9.0+PTX"; \
  export MAX_JOBS="$(nproc)"; \
  pip wheel --no-deps --no-build-isolation -w /opt/src/xformers/dist . ; \
  wheel_path="$(find /opt/src/xformers/dist -mindepth 1 -maxdepth 1 -type f -name '*.whl')"; \
  test $(echo $wheel_path | wc -w) = 1; \
  pip install --no-cache-dir $wheel_path; \
  rm -rf /opt/src/xformers;
