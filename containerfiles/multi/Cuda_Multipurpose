#
# Install bitsandbytes for CUDA
#
# NOTE: source HuggingFace: bitsandbytes is only supported on CUDA GPUs for CUDA versions 11.0 - 12.5.
#       cuda toolkit >= 12.4, matching gcc >= 13
#       line 'export BNB_CUDA_VERSION=117' - from HuggingFace
RUN set -ue; \
  . /opt/venv/bin/activate; \
  export BNB_CUDA_VERSION=128; \
  git clone ${BITSANDBYTES_REPO_URL} /opt/src/bitsandbytes; \
  cd /opt/src/bitsandbytes; \
  git checkout ${BITSANDBYTES_COMMIT}; \
  cmake -DCOMPUTE_BACKEND=cuda -S .; \
  make; \
  pip wheel --no-deps . -w /opt/src/bitsandbytes/dist; \
  wheel_path="$(find /opt/src/bitsandbytes/dist  -mindepth 1 -maxdepth 1 -type f -name '*.whl')"; \
  test $(echo $wheel_path | wc -w) = 1; \
#  new_wheel="$(wretag -d -q LAIFS-on-Olivia_bitsandbytes $wheel_path)"; \
#  pip install --no-cache-dir $new_wheel; \
#  cd / && rm -rf /opt/src/bitsandbytes;
# NOTE: see the log, the build works, what fails is package managment ---> return to the old style for testing
