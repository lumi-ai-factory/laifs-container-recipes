@@ BUILD_ARGS @@

FROM $BASE_IMAGE:$BASE_IMAGE_TAG

ARG BASE_IMAGE
ARG BASE_IMAGE_TAG
ARG PYTORCH_TRITON_URL
ARG FAKE_TRITON_URL
ARG TORCHAUDIO_URL
ARG TORCHVISION_URL
ARG TORCH_URL

RUN set -ue; \
  #
  # Create new venv and install Pytorch
  #
  python3.12 -m venv /opt/venv; \
  . /opt/venv/bin/activate; \
  pip install $PYTORCH_TRITON_URL $TORCHAUDIO_URL $TORCHVISION_URL $TORCH_URL $FAKE_TRITON_URL patchelf /opt/rocm/share/amd_smi; \
  pip cache purge; \
  # Patch torch to prefer system rocm
  patchelf --set-rpath '/opt/rocm/lib:/usr/lib/$(dpkg-architecture -qDEB_HOST_MULTIARCH):$ORIGIN' \
    /opt/venv/lib/python3.12/site-packages/torch/lib/libtorch_hip.so; \
  #
  # Add SBOM
  #
  apt_json="$(dpkg-query -W -f='${Package}\t${Version}\n' | jq -R -s 'split("\n")[:-1] | map(split("\t") | {name: .[0], version: .[1]})')"; \
  pip_json="$(pip list --format=json)"; \
  jq -n --argjson apt "$apt_json"  --argjson pip "$pip_json" '{apt: $apt, pip: $pip}' > /.sbom.json;

ENV PATH="/opt/venv/bin:$PATH"
ENV PYTHONPATH="/opt/venv/lib/python3.12/site-packages:$PYTHONPATH"

RUN printf '#!/bin/bash\n\
if [ "${SLURM_NNODES}" = 1 ] && [ -z "${SLURM_GPUS_ON_NODE}" ]; then\n\
    export FI_HMEM_DISABLE_P2P=1\n\
fi\n\
exec "$@"\n' > /opt/oci-entrypoint.sh && chmod +x > /opt/oci-entrypoint.sh

ENTRYPOINT ["/opt/oci-entrypoint.sh"]
