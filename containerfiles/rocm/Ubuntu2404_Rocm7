ARG BASE_IMAGE
ARG BASE_IMAGE_TAG

FROM $BASE_IMAGE:$BASE_IMAGE_TAG as base

ENV DEBIAN_FRONTEND=noninteractive

ARG BASE_APT_PACKAGES

RUN set -e;\
  #
  printf '%s\n' 'Dpkg::Use-Pty "0";' > /etc/apt/apt.conf.d/99no-progress; \
  #
  # Retry failed downloads, e.g. temporary 503 errors from package mirrors.
  # Applies to all apt commands in this image and the images built on it.
  #
  printf '%s\n' 'Acquire::Retries "5";' > /etc/apt/apt.conf.d/99retries; \
  #
  # Enable man pages with unminimize and install the packages needed
  # before ROCm
  #
  apt-get update && \
  yes | unminimize && \
  apt-get -y --no-install-recommends install man locales ${BASE_APT_PACKAGES} && \
  rm -rf /var/lib/apt/lists/*

FROM base as rocm

ARG ROCM_REPO
ARG ROCM_VERSION
ARG ROCM_GPU_ARCH
ARG ROCM_APT_PACKAGES

RUN set -ue;\
  #
  # Add ROCm repository
  #
  # Download and install GPG key
  mkdir --parents --mode=0755 /etc/apt/keyrings; \
  # ROCm release signing key
  wget -nv ${ROCM_REPO}/gpg/rocm.gpg -O - \
    | gpg --dearmor \
    | tee /etc/apt/keyrings/amdrocm.gpg > /dev/null; \
  #
  printf "deb [arch=amd64 signed-by=/etc/apt/keyrings/amdrocm.gpg] ${ROCM_REPO}/ubuntu2404 stable main\n" \
    | tee /etc/apt/sources.list.d/rocm.list; \
  #
  # Install ROCm packages
  #
  apt-get update && \
  apt-get install -y --no-install-recommends ${ROCM_APT_PACKAGES} && \
  rm -rf /var/lib/apt/lists/*; \
  #
  # Add ROCm to the library path
  echo /opt/rocm/lib > /etc/ld.so.conf.d/rocm-30.conf && \
  ldconfig

ARG EXTRA_LOCALES
ARG EXTRA_APT_PACKAGES

RUN set -e;\
  #
  # Install extra packages and additional locales after ROCm, so that
  # changing them doesn't reinstall ROCm
  #
  apt-get update && \
  apt-get install -y --no-install-recommends ${EXTRA_APT_PACKAGES} && \
  locale-gen ${EXTRA_LOCALES} && \
  rm -rf /var/lib/apt/lists/*

RUN git config --global advice.detachedHead false

RUN set -e;\
  #
  # Add SBOM
  #
  apt_json="$(dpkg-query -W -f='${Package}\t${Version}\n' | jq -R -s 'split("\n")[:-1] | map(split("\t") | {name: .[0], version: .[1]})')"; \
  jq -n \
    --argjson apt "$apt_json" \
    '{apt: $apt}' > /.sbom.json;

ENV ROCM_PATH=/opt/rocm
ENV PYTHONDONTWRITEBYTECODE=1
ENV PIP_NO_CACHE_DIR=1
ENV GIT_TERMINAL_PROMPT=0
