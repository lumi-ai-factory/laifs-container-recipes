# Files that Git should ignore
#

# Build artifacts
/builds/

# Clone of laifs-container-recipes-release-artifacts with the text artifacts
# of published releases
/releases/

# Local temporary files, including the Apptainer temp dir (tmp/apptainer)
/tmp/

# Site specific settings, see .env.example
/.env

# Vim swap files
*.swp

# GitHub authentication
.github/auth

# Code editors and tools
/.vscode/
/.claude/
