#!/bin/bash
#
# Build lumi-multitorch images patched for the emSign CA incident with
# lumi-multitorch-ca-fix.def, and log the builds.
#
# Usage: build-ca-fix [build-tag [image ...]]
#
#   build-tag  release build tag, default u24r70f21m50t210-20260807_115122
#   image      images to patch, default rocm libfabric mpich torch full plus
#
# Each image is built from the released SIF file on the build host,
# $DATA_DIR/lumi-multitorch-<build-tag>/lumi-multitorch-<image>-<build-tag>.sif,
# where DATA_DIR defaults to /data. Like an official release, the patched images get a new build tag with the
# same software versions digest and a timestamp, e.g.
# u24r70f21m50t210-20261102_143005. Set BUILD_ID to choose the timestamp; by
# default it's the current time.
#
# The SIF file, the definition file it was built from (with the source image
# filled in), the build log and the SBOM (/.sbom.json, for
# package_version_diff.py) of each image go to the new release's build
# directory, under the hotfix's directory for the build ID, e.g.
# builds/lumi-multitorch-emsign-ca-2026-10-20261102_143005/lumi-multitorch-u24r70f21m50t210-20261102_143005/,
# with the checksums of all its SIF files in lumi-multitorch-<build-tag>.sha256.
# The build stops if an image's SIF, definition file or log already exists.
#
# Uses Apptainer, or SingularityCE (singularity) e.g. on LUMI. Set VERBOSITY to
# e.g. --verbose or --debug for more output.
#
# Unpacking the image needs tens of GB, and /tmp is often a small tmpfs, so
# point the temporary directory to a disk with space, e.g.:
#
#   APPTAINER_TMPDIR=/var/tmp build-ca-fix      # Apptainer
#   SINGULARITY_TMPDIR=/var/tmp build-ca-fix    # SingularityCE

build_image() {
    local image="$1"

    # Define build paths
    local source_file="$RELEASE_DIR/lumi-multitorch-${image}-${BUILD_TAG}.sif"
    local name="lumi-multitorch-${image}-${HOTFIX_TAG}"
    local sif_file="$BUILD_DIR/$name.sif"
    local def_file="$BUILD_DIR/$name.def"
    local build_log="$BUILD_DIR/$name.log"
    local sbom_file="$BUILD_DIR/$name.json"

    if [ ! -f "$source_file" ]; then
        echo "$source_file not found" >&2
        return 1
    fi

    # Don't overwrite an earlier build or its log
    for file in "$sif_file" "$def_file" "$build_log"; do
        if [ -e "$file" ]; then
            echo "$file already exists, remove it to rebuild" >&2
            return 1
        fi
    done

    # Keep the definition file with the build, like the Containerfiles of an
    # official release, with the source image as the default image argument
    sed "s|^    image=.*|    image=$source_file|" "$DEF_FILE" > "$def_file"

    {
        echo "Image:      $source_file"
        echo "            $(sha256sum "$source_file" | cut -d' ' -f1)"
        echo "Definition: $def_file"
        echo "Recipes:    $RECIPES_COMMIT"
        echo "Output:     $sif_file"
        echo "Builder:    $($CONTAINER --version)"
        echo "Started:    $(date -Iseconds)"
        echo

        $CONTAINER ${VERBOSITY:-} build --fakeroot "$sif_file" "$def_file"

        echo
        echo "Finished:   $(date -Iseconds)"
        sha256sum "$sif_file"

        # Save the SBOM for package_version_diff.py
        $CONTAINER exec "$sif_file" cat /.sbom.json > "$sbom_file"
        echo "SBOM:       $sbom_file"
    } 2>&1 | tee "$build_log"

    echo "Build log: $build_log"
}

main() {
    # Set shell options
    set -euo pipefail

    # Get build args
    BUILD_TAG="${1:-u24r70f21m50t210-20260807_115122}"
    shift || true
    if [ $# -gt 0 ]; then
        IMAGES=("$@")
    else
        IMAGES=(rocm libfabric mpich torch full plus)
    fi

    # New build tag: the release's software versions digest and a timestamp
    BUILD_ID="${BUILD_ID:-$(date +"%Y%m%d_%H%M%S")}"
    HOTFIX_TAG="${BUILD_TAG%-*}-${BUILD_ID}"

    # Define build vars
    SCRIPT_DIR="$(dirname "$(readlink -f "$0")")"
    DEF_FILE="$SCRIPT_DIR/lumi-multitorch-ca-fix.def"
    REPO_DIR="$(git -C "$SCRIPT_DIR" rev-parse --show-toplevel)"
    RELEASE_DIR="${DATA_DIR:-/data}/lumi-multitorch-${BUILD_TAG}"
    BUILD_DIR="$REPO_DIR/builds/lumi-multitorch-emsign-ca-2026-10-${BUILD_ID}/lumi-multitorch-${HOTFIX_TAG}"

    # The commit of this repository, marked if the hotfix files have changes
    RECIPES_COMMIT="$(git -C "$REPO_DIR" rev-parse HEAD)"
    if [ -n "$(git -C "$REPO_DIR" status --porcelain -- "$SCRIPT_DIR")" ]; then
        RECIPES_COMMIT+=" (with uncommitted changes in $(basename "$SCRIPT_DIR"))"
    fi

    # Use Apptainer, or SingularityCE e.g. on LUMI
    if command -v apptainer > /dev/null; then
        CONTAINER=apptainer
    else
        CONTAINER=singularity
    fi

    mkdir -p "$BUILD_DIR"
    echo "Patching release $BUILD_TAG as $HOTFIX_TAG"

    for image in "${IMAGES[@]}"; do
        build_image "$image"
    done

    # Checksums of all SIF files of the release, like an official release
    sha256_file="lumi-multitorch-${HOTFIX_TAG}.sha256"
    (cd "$BUILD_DIR" && sha256sum lumi-multitorch-*-"${HOTFIX_TAG}".sif > "$sha256_file")
    echo "Checksums: $BUILD_DIR/$sha256_file"
}

main "$@"
