#!/bin/bash
#
# List the package changes of lumi-multitorch images patched with build-ca-fix
# against the original release.
#
# Usage: diff-ca-fix build-tag hotfix-build-tag [image ...]
#
#   build-tag         original release build tag, e.g. u24r70f21m50t210-20260807_115122
#   hotfix-build-tag  build tag of the patched images, e.g. u24r70f21m50t210-20261102_143005
#   image             patched images, default rocm libfabric mpich torch full plus
#
# Compares the release's SBOM in $DATA_DIR/lumi-multitorch-<build-tag>/ on the
# build host (DATA_DIR defaults to /data) with the patched image's SBOM in
# builds/lumi-multitorch-emsign-ca-2026-10-<build-id>/lumi-multitorch-<hotfix-build-tag>/,
# where <build-id> is the timestamp of the hotfix build tag, and writes the diff next to the
# latter as lumi-multitorch-<image>-<hotfix-build-tag>-changes.json:
#
#   {"old": "<original SBOM>", "new": "<patched SBOM>",
#    "changes": {"<manager>": {"changed": [{"name", "old", "new"}],
#                              "added": [{"name", "version"}],
#                              "removed": [{"name", "version"}]}}}
#
# with only the package managers that have changes. release-ca-fix renders
# them into the release notes.

usage() {
    echo "Usage: diff-ca-fix build-tag hotfix-build-tag [image ...]"
    exit 1
}

# Diff two SBOMs ({manager: [{name, version}]}) as JSON
diff_sboms() {
    python3 - "$1" "$2" <<'EOF'
import json
import sys
from pathlib import Path

old_file, new_file = map(Path, sys.argv[1:])
old, new = (
    {manager: {p["name"]: p["version"] for p in packages}
     for manager, packages in json.loads(path.read_text()).items()}
    for path in (old_file, new_file)
)

changes = {}
for manager in sorted(old.keys() | new.keys()):
    o, n = old.get(manager, {}), new.get(manager, {})
    diff = {
        "changed": [{"name": k, "old": o[k], "new": n[k]} for k in sorted(o.keys() & n.keys()) if o[k] != n[k]],
        "added": [{"name": k, "version": n[k]} for k in sorted(n.keys() - o.keys())],
        "removed": [{"name": k, "version": o[k]} for k in sorted(o.keys() - n.keys())],
    }
    if any(diff.values()):
        changes[manager] = diff

json.dump({"old": old_file.name, "new": new_file.name, "changes": changes}, sys.stdout, indent=2)
print()
EOF
}

main() {
    # Set shell options
    set -euo pipefail

    # Get args
    [ $# -ge 2 ] || usage
    BUILD_TAG="$1"
    HOTFIX_TAG="$2"
    shift 2
    if [ $# -gt 0 ]; then
        IMAGES=("$@")
    else
        IMAGES=(rocm libfabric mpich torch full plus)
    fi

    # Define paths
    SCRIPT_DIR="$(dirname "$(readlink -f "$0")")"
    REPO_DIR="$(git -C "$SCRIPT_DIR" rev-parse --show-toplevel)"
    RELEASE_DIR="${DATA_DIR:-/data}/lumi-multitorch-${BUILD_TAG}"
    BUILD_DIR="$REPO_DIR/builds/lumi-multitorch-emsign-ca-2026-10-${HOTFIX_TAG##*-}/lumi-multitorch-${HOTFIX_TAG}"

    for image in "${IMAGES[@]}"; do
        name="lumi-multitorch-${image}-${HOTFIX_TAG}"
        changes_file="$BUILD_DIR/$name-changes.json"
        diff_sboms \
            "$RELEASE_DIR/lumi-multitorch-${image}-${BUILD_TAG}.json" \
            "$BUILD_DIR/$name.json" \
            > "$changes_file"
        echo "Package diff: $changes_file"
    done
}

main "$@"
