#!/bin/bash
#
# Build the patched images of all lumi-multitorch releases affected by the
# emSign CA incident with build-ca-fix, list their package changes with
# diff-ca-fix, and prepare the GitHub release with release-ca-fix. All patched
# releases are published as one GitHub release,
# lumi-multitorch-emsign-ca-2026-10. All patched releases and the release's
# assets go to builds/lumi-multitorch-emsign-ca-2026-10-<build-id>/:
#
#   lumi-multitorch-emsign-ca-2026-10-<build-id>-release.md
#       release notes, with the patched releases and their SIF checksums
#   lumi-multitorch-<variant>-<build-id>-release.tgz
#       each patched release's directory without the SIF files
#
# Usage: build-all-ca-fix [build-tag ...] [image ...]
#
#   build-tag  release build tags, default the latest affected release of each
#              variant (software versions digest)
#   image      images to patch, default rocm libfabric mpich torch full plus
#
# A release's images are patched if their SIF files are in
# $DATA_DIR/lumi-multitorch-<build-tag>/ on the build host (DATA_DIR defaults
# to /data); others are skipped, e.g. plus for u24r64 releases, which have no
# plus image. The script checks this for all releases before building.
#
# All patched releases get the same build ID, the timestamp when the script
# started, e.g. u24r70f21m50t210-20261102_151434 and
# u24r64f21m43t29-20261102_151434. Set BUILD_ID to choose it. So only one
# release of each variant can be patched at a time.
#
# Set the temporary directory as for build-ca-fix, e.g.:
#
#   APPTAINER_TMPDIR=/var/tmp build-all-ca-fix      # Apptainer
#   SINGULARITY_TMPDIR=/var/tmp build-all-ca-fix    # SingularityCE

main() {
    # Set shell options
    set -euo pipefail

    # Get args. By default, patch the latest release of each variant.
    BUILD_TAGS=()
    IMAGES=()
    for arg in "$@"; do
        case "$arg" in
            rocm|libfabric|mpich|torch|full|plus) IMAGES+=("$arg") ;;
            *) BUILD_TAGS+=("$arg") ;;
        esac
    done
    if [ ${#BUILD_TAGS[@]} -eq 0 ]; then
        BUILD_TAGS=(
            u24r70f21m50t210-20260807_115122
            u24r64f21m43t29-20260319_153422
        )
    fi
    if [ ${#IMAGES[@]} -eq 0 ]; then
        IMAGES=(rocm libfabric mpich torch full plus)
    fi

    # One build ID for all patched releases
    BUILD_ID="${BUILD_ID:-$(date +"%Y%m%d_%H%M%S")}"

    # A variant can only have one release with this build ID
    duplicates="$(printf "%s\n" "${BUILD_TAGS[@]%-*}" | sort | uniq -d)"
    if [ -n "$duplicates" ]; then
        echo "More than one release of variant $duplicates" >&2
        exit 1
    fi

    # Define paths
    SCRIPT_DIR="$(dirname "$(readlink -f "$0")")"
    REPO_DIR="$(git -C "$SCRIPT_DIR" rev-parse --show-toplevel)"

    # Find each release's images, with their SBOMs, before building anything
    RELEASE_IMAGES=()
    for build_tag in "${BUILD_TAGS[@]}"; do
        release_dir="${DATA_DIR:-/data}/lumi-multitorch-${build_tag}"
        images=""
        for image in "${IMAGES[@]}"; do
            name="lumi-multitorch-${image}-${build_tag}"
            if [ -e "$release_dir/$name.sif" ]; then
                if [ ! -e "$release_dir/$name.json" ]; then
                    echo "$release_dir/$name.json not found" >&2
                    exit 1
                fi
                images+=" $image"
            fi
        done
        if [ -z "$images" ]; then
            echo "None of ${IMAGES[*]} in $release_dir/" >&2
            exit 1
        fi
        RELEASE_IMAGES+=("$images")
    done

    HOTFIX_TAGS=()
    for i in "${!BUILD_TAGS[@]}"; do
        read -ra images <<< "${RELEASE_IMAGES[$i]}"
        hotfix_tag="${BUILD_TAGS[$i]%-*}-${BUILD_ID}"
        HOTFIX_TAGS+=("$hotfix_tag")

        BUILD_ID="$BUILD_ID" "$SCRIPT_DIR/build-ca-fix" "${BUILD_TAGS[$i]}" "${images[@]}"
        "$SCRIPT_DIR/diff-ca-fix" "${BUILD_TAGS[$i]}" "$hotfix_tag" "${images[@]}"
    done

    # Release notes and archives for the GitHub release
    "$SCRIPT_DIR/release-ca-fix" "$BUILD_ID"
}

main "$@"
