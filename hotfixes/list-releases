#!/bin/bash
#
# List the lumi-multitorch release variants, i.e. the major software versions
# digests such as u24r72f21m50t211, with the build tags of their releases.
# Releases are read from the repository's lumi-multitorch-u24* git tags.
#
# Usage: list-releases [--remote]
#
#   --remote  read the tags from origin instead of the local repository

usage() {
    echo "Usage: list-releases [--remote]"
    exit 1
}

version() {
    # Decode a digest field, e.g. 72 -> 7.2 and 211 -> 2.11
    echo "${1:0:1}.${1:1}"
}

main() {
    # Set shell options
    set -euo pipefail

    # Define paths
    SCRIPT_DIR="$(dirname "$(readlink -f "$0")")"

    # Get args
    case "${1:-}" in
        "") tags_cmd=(git -C "$SCRIPT_DIR" tag --list "lumi-multitorch-u24*") ;;
        --remote) tags_cmd=(git -C "$SCRIPT_DIR" ls-remote --tags --refs origin "lumi-multitorch-u24*") ;;
        *) usage ;;
    esac

    # Tags look like lumi-multitorch-u24r72f21m50t211-20261028_090706
    pattern='lumi-multitorch-(u([0-9]+)r([0-9]+)f([0-9]+)m([0-9]+)t([0-9]+))-([0-9]{8}_[0-9]{6})$'

    declare -A releases descriptions
    variants=()
    while read -r tag; do
        [[ $tag =~ $pattern ]] || continue
        variant="${BASH_REMATCH[1]}"
        if [ -z "${releases[$variant]+x}" ]; then
            variants+=("$variant")
            releases[$variant]=""
            descriptions[$variant]="Ubuntu ${BASH_REMATCH[2]}.04, ROCm $(version "${BASH_REMATCH[3]}"), libfabric $(version "${BASH_REMATCH[4]}"), MPICH $(version "${BASH_REMATCH[5]}"), PyTorch $(version "${BASH_REMATCH[6]}")"
        fi
        releases[$variant]+=" ${BASH_REMATCH[7]}"
    done < <("${tags_cmd[@]}" | sed 's|.*refs/tags/||' | sort)

    for variant in "${variants[@]}"; do
        read -ra build_tags <<< "${releases[$variant]}"
        count="${#build_tags[@]} release"
        [ "${#build_tags[@]}" -eq 1 ] || count+="s"
        echo "$variant  ${descriptions[$variant]}  ($count)"
        printf "    %s\n" "${build_tags[@]}"
    done
}

main "$@"
