# Site specific settings for scripts/test-image.sh and the release script of
# a build (<release>-release.sh). Copy this file to .env in the repository
# root and fill in the values. The file is read as a Bash script, so use
# VARIABLE=value without spaces around the equals sign.

# Slurm account used for running the tests
SLURM_ACCOUNT=project_xxxxxxxxx

# User and host for copying the image, running the tests and uploading the
# release to LUMI
SSH_USER=ssh-user
SSH_HOST=ssh-host

# Image staging directory on the remote host
REMOTE_IMAGE_DIR=remote-image-dir

# Directory of the test suite on the remote host
REMOTE_TESTS_DIR=remote-tests-dir
