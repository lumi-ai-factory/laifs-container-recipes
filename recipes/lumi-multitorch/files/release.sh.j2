{#- Release script of a lumi-multitorch build, included into the recipe
    template. Uses these names defined in the recipe template: release_id,
    build_tag, image_variants, release_registry, software_digest and
    image_digest_name(). -#}
#!/bin/bash
#
# This script is used for executing release tasks and should run after
# the post-build script. Working directory needs to be the build dir.
#
# The script performs these actions:
# - Uploads OCI images to Docker Hub
# - Uploads SIF images and release artifacts to LUMI
# - Creates a GitHub release
# - Copies the release artifacts to releases/ and commits them there

set -eu

# Read the site specific settings before uploading anything, see
# .env.example in the repository root
env_file="${LAIFS_ENV_FILE:-../../.env}"
if [ ! -f "$env_file" ]; then
    echo "Error: $env_file not found, create it from .env.example" >&2
    exit 1
fi
source "$env_file"
: "${SSH_USER:?is not set in $env_file}" "${SSH_HOST:?is not set in $env_file}"

# Upload OCI images to Docker Hub
{%- for type in image_variants %}
podman push {{image_digest_name(type)}}:{{build_tag}} docker://docker.io/{{release_registry}}:{{type}}-{{software_digest}}-{{build_tag}}
podman push {{image_digest_name(type)}}:{{build_tag}} docker://docker.io/{{release_registry}}:{{type}}-{{software_digest}}
podman push {{image_digest_name(type)}}:{{build_tag}} docker://docker.io/{{release_registry}}:{{type}}
{% endfor %}

# Upload SIF images and release artifacts to LUMI
rsync -avz --exclude='*.tar' --exclude '*.sh' ../{{release_id}} "${SSH_USER}@${SSH_HOST}:/appl/local/laifs/containers/"
ssh -l $SSH_USER $SSH_HOST chgrp -R appl_laifs /appl/local/laifs/containers/{{release_id}}
ssh -l $SSH_USER $SSH_HOST chmod 664 /appl/local/laifs/containers/{{release_id}}/lumi-multitorch-*
ssh -l $SSH_USER $SSH_HOST chmod o+x /appl/local/laifs/containers/{{release_id}}/lumi-multitorch-*.sif
ssh -l $SSH_USER $SSH_HOST chmod 2775 /appl/local/laifs/containers/{{release_id}}

# Create GitHub release
#
# Run the remaining commands in the root of the `laifs-container-recipes` repo,
# so that the GitHub CLI targets this repository.
cd ../..
#
tar -C builds/ --exclude='*.tar' --exclude '*.tgz' --exclude='*.sif' -czf builds/{{release_id}}-release.tgz {{release_id}}
gh label create --repo https://github.com/lumi-ai-factory/laifs-container-recipes {{release_id}}
gh release create {{release_id}} --verify-tag --notes-file builds/{{release_id}}/{{release_id}}-release.md --title {{release_id}} builds/{{release_id}}-release.tgz

# Copy the text artifacts of the release to releases/, the clone of
# `laifs-container-recipes-release-artifacts`, and commit them there. The
# excluded files match the .gitignore of that repository.
if [ -d releases/.git ]; then
    rsync -a --exclude='*.def' --exclude='*.sh' --exclude='*.sha256' --exclude='*.sif' --exclude='*.tar' --exclude='*.tgz' builds/{{release_id}} releases/
    git -C releases add {{release_id}}
    git -C releases commit -m "Add release {{release_id}}"
    echo "Release artifacts committed in releases/, push them with: git -C releases push"
else
    echo "Warning: releases/ is not a clone of laifs-container-recipes-release-artifacts, artifacts not copied" >&2
fi
