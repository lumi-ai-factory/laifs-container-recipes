#!/bin/bash

set -eu

output="${1:-.github/auth/build.netrc}"

if [[ -z "${GITHUB_TOKEN:-}" ]]; then
  read -rsp "GitHub token: " GITHUB_TOKEN < /dev/tty
  echo >&2
fi

[[ -n "$GITHUB_TOKEN" ]] || { echo "No token provided" >&2; exit 1; }

printf 'machine github.com\nlogin oauth2\npassword %s\n' "$GITHUB_TOKEN" > "$output"

chmod 600 "$output"

echo "GitHub credentials saved to $output"
